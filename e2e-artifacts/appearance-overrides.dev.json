{
  "openWindows": [
    [
      "about:blank",
      "https://example.com/",
      "https://example.org/"
    ]
  ],
  "settings": {
    "tabLifetimeSeconds": 1800,
    "tickSeconds": 2,
    "indicators": [
      "favicon"
    ],
    "faviconStyle": "square",
    "featureFlags": {
      "site-groups": true
    }
  },
  "groups": [
    {
      "id": "g1",
      "name": "news",
      "patterns": [
        "example.org/*"
      ]
    }
  ],
  "rules": [
    {
      "id": "r1",
      "description": "ring on .com",
      "pattern": "example.com/*",
      "match": "wildcard",
      "priority": 5,
      "set": {
        "faviconStyle": "ring"
      }
    },
    {
      "id": "r2",
      "description": "group look",
      "pattern": "@news",
      "match": "wildcard",
      "priority": 5,
      "set": {
        "indicators": [
          "favicon",
          "title-prefix"
        ],
        "faviconStyle": "dot",
        "flashBeforeExpiry": false
      }
    }
  ],
  "captureAfterMs": 9000
}
{
  "runSeconds": 22,
  "dev": {
    "openWindows": [
      [
        "about:blank",
        "https://example.com/"
      ]
    ],
    "settings": {
      "tabLifetimeSeconds": 1800,
      "tickSeconds": 2,
      "indicators": [
        "favicon"
      ],
      "faviconStyle": "square"
    },
    "rules": [
      {
        "id": "r1",
        "description": "dot on .org",
        "pattern": "example.org/*",
        "match": "wildcard",
        "priority": 5,
        "set": {
          "faviconStyle": "dot",
          "tabLifetimeSeconds": 60
        }
      }
    ],
    "navigate": [
      {
        "at": 8000,
        "from": "https://example.com/",
        "to": "https://example.org/"
      }
    ],
    "captureAfterMs": 12000,
    "openUrls": [
      "ui/panel.html?view=page#tabs"
    ]
  },
  "expect": [
    "navigated \\d+ https://example\\.org/",
    "look \\d+ https://example\\.org/ ind=favicon style=dot"
  ],
  "expectNot": [
    "look \\d+ https://example\\.com/ [^\\n]*style=dot"
  ]
}
